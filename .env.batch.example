# MAIC-UI Batch Generation Configuration
# Copy to .env.batch and fill in your values before running scripts.
#
# Quick start for collaborators:
#   1. copy .env.batch.example .env.batch
#   2. Set MAIC_API_BASE to the host machine's LAN IP
#   3. Run: .\scripts\maic_setup.ps1
#   4. Run: .\scripts\maic_generate.ps1 concept examples\concept_derivative.json

# === Required ===
MAIC_API_BASE=http://YOUR_LAN_IP:8000/api
MAIC_EMAIL=test@example.com
MAIC_PASSWORD=Test123456

# === Generation Defaults (can override per-task in TSV) ===
MAIC_MODEL=glm-4.7
MAIC_SUBJECT=
MAIC_GRADE=
MAIC_LANGUAGE=zh
MAIC_GENERATION_MODE=heavy
MAIC_PUBLIC=false

# === Output Paths ===
MAIC_OUT_DIR=maic_outputs
MAIC_BATCH_OUT_DIR=maic_batch_outputs
MAIC_BATCH_LOG_DIR=maic_batch_outputs\logs

# === Batch Settings ===
MAIC_CONTINUE_ON_ERROR=true
MAIC_TIMEOUT_SECONDS=1800
MAIC_PPT_BATCH_SIZE=5
