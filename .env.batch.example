# MAIC-UI Batch Generation Configuration
# Copy to .env.batch and fill in your values before running scripts.
#
# Quick start for local generation:
#   1. Configure model API keys in .env, then start the MAIC-UI backend.
#   2. copy .env.batch.example .env.batch
#   3. Set MAIC_API_BASE to your backend URL, usually http://127.0.0.1:8000/api
#   4. Run: maic-gen setup
#   5. Run: maic-gen concept examples\concept_derivative.json

# === Required ===
MAIC_API_BASE=http://127.0.0.1:8000/api
MAIC_EMAIL=test@example.com
MAIC_PASSWORD=Test123456

# === Generation Defaults (can override per-task in TSV) ===
MAIC_MODEL=glm-4.7
MAIC_SUBJECT=
MAIC_GRADE=
MAIC_LANGUAGE=zh
MAIC_GENERATION_MODE=heavy
MAIC_PUBLIC=false

# === Output Paths ===
MAIC_OUT_DIR=maic_outputs
MAIC_BATCH_OUT_DIR=maic_batch_outputs
MAIC_BATCH_LOG_DIR=maic_batch_outputs\logs

# === Batch Settings ===
MAIC_CONTINUE_ON_ERROR=true
MAIC_TIMEOUT_SECONDS=1800
MAIC_PPT_BATCH_SIZE=5
