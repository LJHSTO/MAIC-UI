# ============================================
# Environment Variables Example
# Copy this file to .env and update with your values
# Do NOT commit real secret keys to version control.
# ============================================

# ------------------
# Security
# ------------------
SECRET_KEY=your-secret-key-change-this-in-production

# ------------------
# Database
# ------------------
# Default uses local SQLite for development. For production replace with a proper DB URL.
DATABASE_URL=sqlite:///./learn_your_way.db

# ------------------
# AI Provider / API Keys (optional)
# ------------------
# 统一使用 SiliconFlow 中转站管理所有模型
# 支持: GLM-5.1 / MiniMax-M2.5 / Qwen3.6-35B-A3B / Claude / GPT / DeepSeek / Gemini / Kimi
AI_PROVIDER=chinese

# SiliconFlow 中转站
TRANSFER_API_KEY=
TRANSFER_BASE_URL=https://api.siliconflow.cn/v1

# ------------------
# App settings
# ------------------
ENVIRONMENT=development  # set to 'production' in production
DEBUG=true
PORT=8000

# Public frontend -> backend URL (used by Next.js in browser)
# For local development when frontend runs in the browser use localhost
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ------------------
# Proxy (optional)
# ------------------
# http_proxy=
# https_proxy=

# ------------------
# Custom domain (for nginx / SSL)
# ------------------
# DOMAIN=your-domain.com
# EMAIL=admin@your-domain.com  # For SSL certificate

# Note: Replace placeholders above with real values in your local `.env`.