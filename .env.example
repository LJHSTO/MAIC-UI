# ============================================
# MAIC-UI Environment Variables Example
# Copy this file to .env and fill in your own values.
# Do NOT commit real secret keys to version control.
# ============================================

# ------------------
# Security
# ------------------
SECRET_KEY=your-secret-key-change-this-in-production

# ------------------
# Database
# ------------------
# Default uses local SQLite for development. For production replace with PostgreSQL.
DATABASE_URL=sqlite:///./learn_your_way.db

# ------------------
# AI Provider / API Keys
# ------------------
# Batch scripts do not call model providers directly. They call the MAIC-UI backend,
# and the backend uses the credentials below to generate courseware.
AI_PROVIDER=chinese

# Default OpenAI-compatible transfer endpoint, for example SiliconFlow.
TRANSFER_API_KEY=
TRANSFER_BASE_URL=https://api.siliconflow.cn/v1
TRANSFER_MODEL=glm-4.7

# Optional provider-specific keys. Fill only what you use.
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4.7
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_BASE_URL=
KIMI_API_KEY=
KIMI_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
INNOSPARK_API_KEY=
INNOSPARK_BASE_URL=https://api.innospark.cn/v1

# ------------------
# App settings
# ------------------
ENVIRONMENT=development
DEBUG=true
PORT=8000

# Browser-facing frontend -> backend URL.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ------------------
# Optional proxy
# ------------------
# http_proxy=
# https_proxy=

# ------------------
# Optional custom domain / SSL
# ------------------
# DOMAIN=your-domain.com
# EMAIL=admin@your-domain.com
